# Look through a creature's eyes, walk in 3D, switch to another creature.
seed 12
menu START GAME
key CAST
digit 1
endturn
key VIEW
expect mode VIEW3D
tick 20
screenshot pov_inside_house
key LEFT 2
key UP
expect wizard_at 0 6 5
key DOWN
key UP
expect wizard_at 0 5 5
key NEXT
expect mode VIEW3D
tick 20
screenshot pov_goblin
key CANCEL
expect mode PLAY
