# A phone player: taps, double taps to confirm, drags to scroll, swipes in 3D.
seed 9
tap 240 166
expect mode PLAY
tapbutton CAST
menu 2 DWARF
expect creatures 0 == 2
tapbutton END TURN
expect confirm 1
tapbutton CONFIRM
expect turn == 2
# first tap previews, second tap walks
tapmap 6 5
expect wizard_at 0 5 5
expect msg TAP AGAIN
tapmap 6 5
expect wizard_at 0 6 5
# tapping an own creature selects it at once
tapmap 5 4
expect selected DWARF
# one-finger drag scrolls the map
drag 32 0
expect view 30 0
drag -32 0
expect view 0 0
# 3D: swipe to turn, tap the middle to step, exit button
tapbutton 3D VIEW
expect mode VIEW3D
drag -32 0
tap 96 80
tick 20
screenshot touch_pov
tapbutton EXIT 3D
expect mode PLAY
