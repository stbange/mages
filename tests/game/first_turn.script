# Turn one with the keyboard: summoning is allowed, walking is not.
seed 21
players 1 1
menu START GAME
expect mode PLAY
expect selected WIZARD
key RIGHT
key FIRE
expect msg NO MOVEMENT ON THE FIRST TURN
expect wizard_at 0 5 5
# C opens the spell book, number keys cast
key CAST
expect mode LIST
digit 1
expect creatures 0 == 3
expect sound 7
key CAST
digit 8
expect creatures 0 == 4
expect mana 0 == 39
expect ap == 6
screenshot first_turn_summoned
endturn
expect turn == 2
expect player == 0
expect creatures 1 >= 2
expect mana 0 == 41
expect palette_only
